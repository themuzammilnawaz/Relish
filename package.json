{
  "name": "relish-pizza-bar",
  "version": "1.0.0",
  "private": true,
  "description": "Relish Pizza Bar — wood-fired, handcrafted, served with soul. Khanqah Sharif, Bahawalpur.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
